#!/bin/bash
 
#Mientras tengas más de un argumento
while [[ $# -gt 0 ]]
do
	
	#Definimos la variable con el primer argumento para no tener que renombrar todo el script
	nombre="$1"

	#Comprobamos si NO existe el archivo
	[ ! -e "$nombre" ] && { echo "El fichero $nombre no existe"; shift;  continue; }

	#Si el archivo existe pero no es un fichero normal
	[ ! -f "$nombre" ] && { echo "$nombre existe, pero no es un fichero normal"; shift; continue; }

	#Si el archivo existe Y es un fichero, contamos las líneas
	[ -f "$nombre" ] &&  echo "$(wc -l < "$nombre") $nombre"
 	
	shift	#Pasamos al siguiente argumento
done 
